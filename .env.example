# ---------------------------------------------------------------------------
# Supabase — Project settings → API
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server only. Never expose it: it bypasses Row Level Security.
# The dashboard and /api/generate work without it; the Stripe webhook does not.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---------------------------------------------------------------------------
# AI provider — Groq by default: free tier, no credit card required.
#   AI_PROVIDER: groq | gemini | openai
#   Default models: groq → openai/gpt-oss-120b · gemini → gemini-3.8-flash
#                   openai → gpt-4o-mini
# ---------------------------------------------------------------------------
AI_PROVIDER=groq
GROQ_API_KEY=gsk_your-groq-api-key

# Only needed when AI_PROVIDER=gemini
# GEMINI_API_KEY=AIza_your-gemini-api-key

# Only needed when AI_PROVIDER=openai
# OPENAI_API_KEY=sk-your-openai-api-key

# Optional overrides
# AI_MODEL=openai/gpt-oss-20b     # faster + cheaper than the 120b default
# AI_MAX_TOKENS=2048             # reasoning models spend part of this thinking
# AI_TIMEOUT_MS=45000

# ---------------------------------------------------------------------------
# Stripe — dashboard.stripe.com/apikeys and /webhooks
# ---------------------------------------------------------------------------
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-signing-secret
STRIPE_PRICE_ID_STARTER=price_your-starter-price-id
STRIPE_PRICE_ID_PRO=price_your-pro-price-id

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
